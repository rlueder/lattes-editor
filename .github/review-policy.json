{
  "enabled": true,
  "provider": "openrouter",
  "fallbackProviders": [],
  "includePaths": [
    "src/**",
    "extension/**",
    "src-tauri/src/**",
    "scripts/**",
    "tests/**",
    ".github/workflows/**"
  ],
  "excludePaths": ["fixtures/**", "private/**"],
  "scanForSecretsBeforeSending": true,
  "onSensitiveContent": "block"
}
