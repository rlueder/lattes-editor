{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LattesEditor",
  "mainBinaryName": "LattesEditor",
  "version": "../package.json",
  "identifier": "dev.lattes-editor.app",
  "build": {
    "beforeDevCommand": "pnpm exec vite --port 5196 --strictPort",
    "devUrl": "http://localhost:5196",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LattesEditor",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://servicosweb.cnpq.br",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.crossref.org",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://servicosweb.cnpq.br",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.crossref.org ws://localhost:5196",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Editor local do Currículo Lattes",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQjkwMDVBQUVERkQ5RkIKUldUNzJkK3VXZ0M1YzV2eXpUOUFJSXpJWEZ2bXc5SDIxUWN2N1kyc0FxTzdCRU5kYi9Jd25NVEcK",
      "endpoints": ["https://github.com/rlueder/lattes-editor/releases/latest/download/latest.json"]
    }
  }
}
