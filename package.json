{
  "name": "lattes-editor",
  "version": "0.24.1",
  "private": true,
  "description": "Editor local do Currículo Lattes: carrega a exportação XML, edita e gera XML para o Importar do Lattes.",
  "license": "MIT",
  "author": "Rafael Lüder",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:censo": "node scripts/build-censo.ts",
    "build:extension": "node scripts/build-extension.ts",
    "build:extension:loja": "node scripts/build-extension.ts --loja",
    "capture:animacoes": "node scripts/capture-animacoes.ts",
    "capture:screenshots": "node scripts/capture-screenshots.ts",
    "capture:store": "node scripts/capture-store.ts",
    "censo:relatorio": "node scripts/censo-relatorio.ts",
    "desktop:build": "tauri build --bundles app",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev": "vite",
    "dev:demo": "vite --port 5198 --strictPort --open /?exemplo=demo",
    "dev:exemplo": "vite --port 5199 --strictPort --open /?exemplo",
    "dev:lattes": "node scripts/lattes-simulado/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:demo": "node scripts/gen-demo.ts",
    "gen:fixtures": "node scripts/gen-fixtures.ts",
    "gen:schema": "node scripts/gen-schema.ts",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "semantic-release",
    "tauri": "tauri",
    "test": "vitest run",
    "test:censo-isolation": "pnpm build:extension --canal-dev && node scripts/test-censo-isolation.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "validate:fixtures": "node scripts/validate-fixtures.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{js,cjs,mjs,json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "dexie": "^4.4.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@precisa-saude/commitlint-config": "^3.4.0",
    "@precisa-saude/eslint-config": "^3.4.0",
    "@precisa-saude/prettier-config": "^3.4.0",
    "@precisa-saude/tsconfig": "^3.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
